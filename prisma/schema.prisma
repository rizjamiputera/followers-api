// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    // output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    SUPERADMIN // everything
    ADMIN //manage all data, user dibawahnya
    OPERATOR // permission based
    USER // readers
}

enum Permission {
    READ
    CREATE
    EDIT
    DELETE
    APPROVE
    PUBLISH
}

enum Module {
    ARTICLE
    USER
    COMMENT
}

model User {
    id                String            @id @default(uuid())
    name              String            @db.VarChar(100)
    email             String            @unique @db.VarChar(255)
    avatar            String?           @db.VarChar(255)
    avatar_md         String?           @db.VarChar(255)
    role              UserRole
    password          Password?
    auths             Auth[]
    active            Boolean           @default(true)
    createdAt         DateTime          @default(now())
    updatedAt         DateTime          @updatedAt
    deleted           Boolean           @default(false)
    permissions       UserPermission[]
    ErrorLog          ErrorLog[]
    articles          Article[]         @relation("author_articles")
    articles_approved Article[]         @relation("article_approver")
    articles_reaction ArticleReaction[]
    articles_comments Comment[]

    @@index([email])
    @@map("user")
}

model Password {
    id        String   @id @default(uuid())
    user      User     @relation(fields: [userId], references: [id])
    userId    String   @unique
    password  String   @db.VarChar(255)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("password")
}

model UserPermission {
    id         String     @id @default(uuid())
    userId     String
    module     Module
    permission Permission
    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, module, permission])
    @@map("user_permission")
}

model Auth {
    id           String   @id @default(uuid())
    User         User     @relation(fields: [userId], references: [id])
    userId       String
    access_token String   @db.VarChar(300)
    expiredAt    DateTime @default(now())
    path         String   @db.VarChar(100)
    method       String   @db.VarChar(100)
    createdAt    DateTime @default(now())

    @@map("auth")
}

model ErrorLog {
    id          Int      @id @default(autoincrement())
    message     String
    stack       String?
    path        String?
    method      String?
    statusCode  Int?
    user        User?    @relation(fields: [userId], references: [id])
    userId      String?
    requestData Json?    @db.JsonB
    headers     Json?    @db.JsonB
    createdAt   DateTime @default(now())

    @@map("error-log")
}

// ARTICLES
enum ArticleStatus {
    DRAFT
    PENDING_REVIEW
    REJECTED
    PUBLISHED
}

enum ReactionType {
    LIKE
    DISLIKE
}

model Article {
    id            String            @id @default(uuid())
    title         String            @db.VarChar(255)
    slug          String            @unique @db.VarChar(255)
    excerpt       String?           @db.VarChar(500)
    content       String            @db.Text // markdown or HTML
    featuredImage String?           @db.VarChar(255)
    isFeatured    Boolean           @default(false)
    status        ArticleStatus     @default(DRAFT)
    scheduledAt   DateTime? // when scheduled to be published
    publishedAt   DateTime? // actual publish time
    approvedAt    DateTime?
    approvalNote  String?           @db.Text
    author        User              @relation("author_articles", fields: [authorId], references: [id])
    approvedBy    User?             @relation("article_approver", fields: [approvedById], references: [id])
    approvedById  String?
    authorId      String
    tags          ArticleTag[]
    comments      Comment[]
    reactions     ArticleReaction[]
    createdAt     DateTime          @default(now())
    updatedAt     DateTime          @updatedAt
    deleted       Boolean           @default(false)

    @@index([status, publishedAt])
    @@map("article")
}

model Tag {
    id        String       @id @default(uuid())
    name      String       @unique @db.VarChar(100)
    slug      String       @unique @db.VarChar(100)
    articles  ArticleTag[]
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt

    @@map("tag")
}

model ArticleTag {
    id        String  @id @default(uuid())
    article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId String
    tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
    tagId     String

    @@unique([articleId, tagId])
    @@map("article_tag")
}

model ArticleReaction {
    id        String       @id @default(uuid())
    article   Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId String
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String
    type      ReactionType
    createdAt DateTime     @default(now())

    @@unique([articleId, userId]) // one reaction per user per article
    @@map("article_reaction")
}

model Comment {
    id        String    @id @default(uuid())
    article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId String
    user      User      @relation(fields: [userId], references: [id])
    userId    String
    parent    Comment?  @relation("comment_replies", fields: [parentId], references: [id], onDelete: Cascade)
    parentId  String?
    replies   Comment[] @relation("comment_replies")
    content   String    @db.Text
    isEdited  Boolean   @default(false)
    deleted   Boolean   @default(false)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@index([articleId])
    @@map("comment")
}
