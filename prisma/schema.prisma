// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    // output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    SUPERADMIN // everything
    ADMIN //manage all data, user dibawahnya
    OPERATOR // permission based
    USER // readers
}

enum Permission {
    READ
    CREATE
    EDIT
    DELETE
    APPROVE // can approve article
    PUBLISH // can publish or take down article
}

enum Module {
    ARTICLE
    USER
    COMMENT
}

model User {
    id               String            @id @default(uuid())
    name             String            @db.VarChar(100)
    email            String            @unique @db.VarChar(255)
    avatar           String?           @db.VarChar(255)
    avatar_md        String?           @db.VarChar(255)
    role             Role
    password         Password?
    auths            Auth[]
    active           Boolean           @default(true)
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
    deleted          Boolean           @default(false)
    permissions      UserPermission[]
    ErrorLog         ErrorLog[]
    articles         Article[]         @relation("author_articles")
    articleApprovals ArticleApproval[] @relation("article_approvals")
    articlesReaction ArticleReaction[]
    articlesComments Comment[]
    commentReactions CommentReaction[]
    visits           Visitor[]

    @@index([email])
    @@map("user")
}

model Password {
    id        String   @id @default(uuid())
    user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
    userId    String   @unique
    password  String   @db.VarChar(255)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("password")
}

model UserPermission {
    id         String     @id @default(uuid())
    userId     String
    module     Module
    permission Permission
    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, module, permission])
    @@map("user_permission")
}

model Auth {
    id           String   @id @default(uuid())
    User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId       String
    access_token String   @db.VarChar(300)
    expiredAt    DateTime @default(now())
    path         String   @db.VarChar(100)
    method       String   @db.VarChar(100)
    createdAt    DateTime @default(now())

    @@map("auth")
}

model ErrorLog {
    id          Int      @id @default(autoincrement())
    message     String
    stack       String?
    path        String?
    method      String?
    statusCode  Int?
    user        User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
    userId      String?
    requestData Json?    @db.JsonB
    headers     Json?    @db.JsonB
    createdAt   DateTime @default(now())

    @@map("error-log")
}

// ARTICLES
enum ArticleStatus {
    DRAFT
    ON_REVIEW
    REJECTED
    APPROVED
    PUBLISHED
    TAKE_DOWN
}

enum ApprovalStatus {
    REJECTED
    APPROVED
    TAKE_DOWN
}

model Article {
    id          String                  @id @default(uuid())
    slug        String                  @unique @db.VarChar(255)
    title       String                  @db.VarChar(255)
    excerpt     String?                 @db.VarChar(500)
    image       String                  @db.VarChar(255)
    image_sm    String                  @db.VarChar(255)
    content     ArticleContent          @relation(fields: [contentId], references: [id], onDelete: Restrict)
    contentId   String                  @unique
    versions    ArticleContentVersion[]
    isFeatured  Boolean                 @default(false)
    status      ArticleStatus           @default(DRAFT)
    publishedAt DateTime? // actual publish time
    author      User                    @relation("author_articles", fields: [authorId], references: [id], onDelete: Restrict)
    authorId    String
    approvals   ArticleApproval[]
    tags        ArticleTag[]
    comments    Comment[]
    reactions   ArticleReaction[]
    createdAt   DateTime                @default(now())
    updatedAt   DateTime                @updatedAt
    deleted     Boolean                 @default(false)
    readStat    ArticleReadStat         @relation(fields: [readStatId], references: [id], onDelete: Restrict)
    readStatId  String                  @unique
    visitors    Visit[]

    @@index([status, publishedAt])
    @@index([authorId, status])
    @@index([deleted, status, publishedAt])
    @@map("article")
}

model ArticleContent {
    id        String   @id @default(uuid())
    content   Json     @db.JsonB // structured content only
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    article   Article?

    @@map("article_content")
}

model ArticleContentVersion {
    id        String   @id @default(uuid())
    title     String   @db.VarChar(255)
    excerpt   String?  @db.VarChar(500)
    content   Json     @db.JsonB // structured content
    image     String   @db.VarChar(255)
    image_sm  String   @db.VarChar(255)
    createdAt DateTime @default(now())
    article   Article  @relation(fields: [articleId], references: [id])
    articleId String

    @@index([articleId])
    @@map("article_content_version")
}

model ArticleApproval {
    id         String         @id @default(uuid())
    article    Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId  String
    approver   User           @relation("article_approvals", fields: [approverId], references: [id], onDelete: Restrict)
    approverId String
    status     ApprovalStatus @default(REJECTED)
    note       String?        @db.Text
    createdAt  DateTime       @default(now())

    @@index([articleId])
    @@map("article_approval")
}

model Tag {
    id        String       @id @default(uuid())
    name      String       @unique @db.VarChar(100)
    slug      String       @unique @db.VarChar(100)
    articles  ArticleTag[]
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt

    @@map("tag")
}

model ArticleTag {
    id        String  @id @default(uuid())
    article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId String
    tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
    tagId     String

    @@unique([articleId, tagId])
    @@map("article_tag")
}

model ArticleReaction {
    id        String   @id @default(uuid())
    article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String
    // Instead of enum LIKE/DISLIKE, make it string for future emojis
    // Example: "like", "dislike", "love", "clap"
    type      String
    createdAt DateTime @default(now())

    @@unique([articleId, userId]) // one reaction per user per article
    @@map("article_reaction")
}

enum ReactionType {
    like
    dislike
    love
    clap
}

model Comment {
    id        String            @id @default(uuid())
    article   Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId String
    user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
    userId    String
    parent    Comment?          @relation("comment_replies", fields: [parentId], references: [id], onDelete: Cascade)
    parentId  String?
    replies   Comment[]         @relation("comment_replies")
    reactions CommentReaction[]
    content   String            @db.Text
    isEdited  Boolean           @default(false)
    deleted   Boolean           @default(false)
    createdAt DateTime          @default(now())
    updatedAt DateTime          @updatedAt

    @@index([articleId])
    @@map("comment")
}

model CommentReaction {
    id        String   @id @default(uuid())
    comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
    commentId String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String
    type      String   @default("loved") // Always "loved" for now
    createdAt DateTime @default(now())

    @@unique([commentId, userId]) // one reaction per user per comment
    @@map("comment_reaction")
}

// ARTICLE STATS
model ArticleReadStat {
    id         String    @id @default(uuid())
    article    Article?
    readCount  Int       @default(0)
    lastReadAt DateTime?

    @@map("article_read_stat")
}

model Visit {
    id        String   @id @default(uuid())
    // onDelete SetNull: article can be deleted, but visits keep to keep analytics
    article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
    articleId String?
    // onDelete SetNull: visitor can be deleted, but visits keep record
    visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
    visitorId String?
    ipAddress String?  @db.VarChar(45)
    userAgent String?  @db.VarChar(500)
    referrer  String?  @db.VarChar(500)
    visitedAt DateTime @default(now())

    @@index([articleId, visitedAt])
    @@map("visit")
}

model Visitor {
    id           String   @id @default(uuid())
    fingerprint  String?  @db.VarChar(255)
    firstVisitAt DateTime @default(now())
    lastVisitAt  DateTime @default(now())
    visits       Visit[]
    // onDelete SetNull: if user deleted, visitor stays for analytics, but link removed
    userId       String?
    user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@unique([fingerprint])
    @@map("visitor")
}
