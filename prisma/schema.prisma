// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    // output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    SUPERADMIN // everything
    ADMIN //manage all data, user dibawahnya
    OPERATOR // permission based
    USER // readers
}

enum Permission {
    READ
    CREATE
    EDIT
    DELETE
    APPROVE // can approve, publish or take down article
}

enum Module {
    ARTICLE
    EVENT
    USER
    COMMENT
}

model User {
    id               String            @id @default(uuid())
    name             String            @db.VarChar(100)
    email            String            @unique @db.VarChar(255)
    avatar           String?           @db.VarChar(255)
    avatar_md        String?           @db.VarChar(255)
    role             Role
    password         Password?
    auths            Auth[]
    active           Boolean           @default(true)
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
    deleted          Boolean           @default(false)
    permissions      UserPermission[]
    ErrorLog         ErrorLog[]
    articles         Article[]         @relation("author_articles")
    events           Event[]           @relation("author_events")
    contentApprovals ContentApproval[] @relation("content_approvals")
    articlesReaction ContentReaction[]
    articlesComments Comment[]         @relation("comment")
    commentReactions CommentReaction[]
    mentions         Comment[]         @relation("comment_mentions")
    visits           Visitor[]
    profile          Profile?
    isProfilePublic  Boolean           @default(false)
    followers        Follow[]          @relation("UserFollowers")
    following        Follow[]          @relation("UserFollowing")
    ratingsGiven     UserRating[]      @relation("RatingsGiven")
    ratingsReceived  UserRating[]      @relation("RatingsReceived")
    articleBookmarks ArticleBookmark[]

    @@index([email])
    @@map("user")
}

model Password {
    id        String   @id @default(uuid())
    user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
    userId    String   @unique
    password  String   @db.VarChar(255)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("password")
}

model UserPermission {
    id         String     @id @default(uuid())
    userId     String
    module     Module
    permission Permission
    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, module, permission])
    @@map("user_permission")
}

model Auth {
    id           String   @id @default(uuid())
    User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId       String
    access_token String   @db.VarChar(300)
    expiredAt    DateTime @default(now())
    path         String   @db.VarChar(100)
    method       String   @db.VarChar(100)
    createdAt    DateTime @default(now())

    @@map("auth")
}

model ErrorLog {
    id          Int      @id @default(autoincrement())
    message     String
    stack       String?
    path        String?
    method      String?
    statusCode  Int?
    user        User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
    userId      String?
    requestData Json?    @db.JsonB
    headers     Json?    @db.JsonB
    createdAt   DateTime @default(now())

    @@map("error-log")
}

// ARTICLES
enum ContentStatus {
    DRAFT
    ON_REVIEW
    REJECTED
    PUBLISHED
    TAKE_DOWN
}

enum ApprovalStatus {
    REJECTED
    PUBLISHED
    TAKE_DOWN
}

model Article {
    id          String            @id @default(uuid())
    slug        String            @unique @db.VarChar(255)
    title       String            @db.VarChar(255)
    excerpt     String            @db.VarChar(500)
    image       String            @db.VarChar(255)
    image_md    String            @db.VarChar(255)
    content     Content           @relation(fields: [contentId], references: [id], onDelete: Restrict)
    contentId   String            @unique
    photos      PhotoContent[]
    versions    ContentVersion[]
    isFeatured  Boolean           @default(false)
    status      ContentStatus     @default(DRAFT)
    publishedAt DateTime? // actual publish time
    author      User              @relation("author_articles", fields: [authorId], references: [id], onDelete: Restrict)
    authorId    String
    approvals   ContentApproval[]
    tags        ContentTag[]
    reactions   ContentReaction[]
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt
    deleted     Boolean           @default(false)
    stats       ContentStats      @relation(fields: [statsId], references: [id])
    statsId     String            @unique
    visitors    Visit[]
    bookmarks   ArticleBookmark[]

    @@index([status, publishedAt])
    @@index([authorId, status])
    @@index([deleted, status, publishedAt])
    @@map("article")
}

/**
 * schedule
 * location
 * address
 * Will Attendance
 * Pemateri
 */
model Event {
    id          String            @id @default(uuid())
    slug        String            @unique @db.VarChar(255)
    title       String            @db.VarChar(255)
    excerpt     String            @db.VarChar(500)
    image       String            @db.VarChar(255)
    image_md    String            @db.VarChar(255)
    content     Content           @relation(fields: [contentId], references: [id], onDelete: Restrict)
    contentId   String            @unique
    location    String?
    address     String?
    start_at    DateTime
    end_at      DateTime?
    photos      PhotoContent[]
    versions    ContentVersion[]
    isFeatured  Boolean           @default(false)
    status      ContentStatus     @default(DRAFT)
    publishedAt DateTime? // actual publish time
    author      User              @relation("author_events", fields: [authorId], references: [id], onDelete: Restrict)
    authorId    String
    approvals   ContentApproval[]
    tags        ContentTag[]
    reactions   ContentReaction[]
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt
    deleted     Boolean           @default(false)
    stats       ContentStats      @relation(fields: [statsId], references: [id])
    statsId     String            @unique
    visitors    Visit[]

    @@index([status, publishedAt])
    @@index([authorId, status])
    @@index([deleted, status, publishedAt])
    @@map("event")
}

// Content STATS
model ContentStats {
    id            String    @id @default(uuid())
    readCount     Int       @default(0)
    commentCount  Int       @default(0)
    likeCount     Int       @default(0)
    dislikeCount  Int       @default(0)
    shareCount    Int       @default(0)
    bookmarkCount Int       @default(0)
    lastReadAt    DateTime?
    event         Event?
    article       Article?

    @@map("content_stats")
}

model Content {
    id        String    @id @default(uuid())
    content   Json      @db.JsonB // structured content only
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    comments  Comment[]
    article   Article?
    event     Event?

    @@map("content")
}

model ContentVersion {
    id        String   @id @default(uuid())
    title     String   @db.VarChar(255)
    excerpt   String?  @db.VarChar(500)
    content   Json     @db.JsonB // structured content
    image     String   @db.VarChar(255)
    image_sm  String   @db.VarChar(255)
    createdAt DateTime @default(now())
    article   Article? @relation(fields: [articleId], references: [id])
    articleId String?
    event     Event?   @relation(fields: [eventId], references: [id])
    eventId   String?

    @@index([articleId])
    @@index([eventId])
    @@map("content_version")
}

model PhotoContent {
    id         String   @id @default(uuid())
    path       String   @db.VarChar(255)
    article    Article? @relation(fields: [articleId], references: [id])
    articleId  String?
    event      Event?   @relation(fields: [eventId], references: [id])
    eventId    String?
    main_photo Boolean  @default(false)
    createdAt  DateTime @default(now())

    @@map("photo_content")
}

model ContentApproval {
    id         String         @id @default(uuid())
    article    Article?       @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId  String?
    event      Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
    eventId    String?
    approver   User           @relation("content_approvals", fields: [approverId], references: [id], onDelete: Restrict)
    approverId String
    status     ApprovalStatus @default(REJECTED)
    note       String?        @db.Text
    createdAt  DateTime       @default(now())

    @@index([articleId])
    @@map("content_approval")
}

model Tag {
    id        String       @id @default(uuid())
    name      String       @unique @db.VarChar(100)
    slug      String       @unique @db.VarChar(100)
    contents  ContentTag[]
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt

    @@map("tag")
}

model ContentTag {
    id        String   @id @default(uuid())
    article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId String?
    event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
    eventId   String?
    tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
    tagId     String

    @@unique([articleId, tagId])
    @@map("content_tag")
}

model ContentReaction {
    id        String       @id @default(uuid())
    article   Article?     @relation(fields: [articleId], references: [id], onDelete: Cascade)
    articleId String?
    event     Event?       @relation(fields: [eventId], references: [id])
    eventId   String?
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String
    // Instead of enum LIKE/DISLIKE, make it string for future emojis
    // Example: "like", "dislike", "love", "clap"
    type      ReactionType @default(like) // Always "like" for now
    createdAt DateTime     @default(now())

    @@unique([articleId, userId]) // one reaction per user per article
    @@unique([eventId, userId]) // one reaction per user per event
    @@index([articleId, type])
    @@index([eventId, type])
    @@map("article_reaction")
}

enum ReactionType {
    like
    dislike
    love
    clap
}

model Comment {
    id          String            @id @default(uuid())
    user        User              @relation("comment", fields: [userId], references: [id], onDelete: Restrict)
    userId      String
    content     Content           @relation(fields: [contentId], references: [id])
    contentId   String
    comment     String            @db.Text
    reactions   CommentReaction[]
    // Always points to top-level comment if it's a reply
    parent      Comment?          @relation("comment_replies", fields: [parentId], references: [id], onDelete: Cascade)
    parentId    String?
    replies     Comment[]         @relation("comment_replies")
    // Mentioned user (optional, for replying to a reply)
    mentioned   User?             @relation("comment_mentions", fields: [mentionedId], references: [id], onDelete: SetNull)
    mentionedId String?
    isEdited    Boolean           @default(false)
    deleted     Boolean           @default(false)
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt

    @@index([contentId])
    @@map("comment")
}

model CommentReaction {
    id        String       @id @default(uuid())
    comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
    commentId String
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String
    type      ReactionType @default(like) // Always "like" for now
    createdAt DateTime     @default(now())

    @@unique([commentId, userId]) // one reaction per user per comment
    @@map("comment_reaction")
}

model Visit {
    id        String   @id @default(uuid())
    // onDelete NoAction: article can be deleted, but visits keep to keep analytics
    article   Article? @relation(fields: [articleId], references: [id], onDelete: NoAction)
    articleId String?
    // onDelete NoAction: event can be deleted, but visits keep to keep analytics
    event     Event?   @relation(fields: [eventId], references: [id], onDelete: NoAction)
    eventId   String?
    // path   // e.g. "/", "/articles/123", "/events/abc", "/search?q=foo"
    path      String   @db.VarChar(500)
    // onDelete NoAction: visitor can be deleted, but visits keep record
    visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: NoAction)
    visitorId String?
    ipAddress String?  @db.VarChar(45)
    userAgent String?  @db.VarChar(500)
    referrer  String?  @db.VarChar(500)
    visitedAt DateTime @default(now())

    @@index([articleId, visitedAt])
    @@index([eventId, visitedAt])
    @@index([path, visitedAt])
    @@map("visit")
}

model Visitor {
    id           String   @id @default(uuid())
    fingerprint  String?  @db.VarChar(255)
    firstVisitAt DateTime @default(now())
    lastVisitAt  DateTime @default(now())
    visits       Visit[]
    // onDelete SetNull: if user deleted, visitor stays for analytics, but link removed
    userId       String?
    user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@unique([fingerprint])
    @@map("visitor")
}

model ArticleBookmark {
    id        String  @id @default(uuid())
    user      User    @relation(fields: [userId], references: [id])
    userId    String
    article   Article @relation(fields: [articleId], references: [id])
    articleId String

    @@unique([userId, articleId])
    @@map("article_bookmark")
}

