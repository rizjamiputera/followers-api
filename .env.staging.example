# Copy to .env.staging on the VPS and fill in real values.
# docker-compose-staging.yml reads this via env_file + variable substitution.
# Never commit the real .env.staging.

# ── App ──
PORT=5000
NODE_ENV=production
APP_NAME=Followers Bicara
WEB_URI=https://stg.followersbicara.com
API_URI=https://stg-api.followersbicara.com

# ── Auth (must differ from prod) ──
JWTSECRET=CHANGE_ME_STG_JWT_SECRET
JWT_EXPIRATION=180

# ── Database (staging has its own postgres container) ──
DB_USER=followersBicaraDong
DB_PASSWORD=CHANGE_ME_STG_DB_PASSWORD
DB_NAME=postgres
DB_SCHEMA=followers
DATABASE_URL=postgresql://followersBicaraDong:CHANGE_ME_STG_DB_PASSWORD@stg_followers_bicara_postgre:5432/postgres?schema=followers

# ── Puppeteer ──
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Email ──
EMAIL_USER=udaputera.hostinger@gmail.com
EMAIL_PASSWORD="CHANGE ME GMAIL APP PASSWORD"

# ── Image tag (set by deploy workflow; defaults to :stg-latest) ──
# STG_API_IMAGE_TAG=stg-0.1.0
