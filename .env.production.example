# Copy to .env.production on the VPS and fill in real values.
# docker-compose-production.yml reads this via env_file + variable substitution.
# Never commit the real .env.production.

# ── App ──
PORT=5000
NODE_ENV=production
APP_NAME=Followers Bicara
WEB_URI=https://followersbicara.com
API_URI=https://api.followersbicara.com

# ── Auth ──
JWTSECRET=CHANGE_ME_PROD_JWT_SECRET
JWT_EXPIRATION=180

# ── Database (used by both postgres container and app) ──
DB_USER=followersBicaraDong
DB_PASSWORD=CHANGE_ME_PROD_DB_PASSWORD
DB_NAME=postgres
DB_SCHEMA=followers
DATABASE_URL=postgresql://followersBicaraDong:CHANGE_ME_PROD_DB_PASSWORD@prod_followers_bicara_postgre:5432/postgres?schema=followers

# ── Puppeteer ──
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Email (Gmail App Password) ──
EMAIL_USER=udaputera.hostinger@gmail.com
EMAIL_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD

# ── Image tag (set by deploy workflow; defaults to :latest) ──
# API_IMAGE_TAG=v1.8.0

# ── Offsite backup (optional; requires rclone configured on VPS) ──
# Uncomment and set to enable uploading each backup to cloud storage.
# See DEPLOY.md § Offsite backup for rclone + Cloudflare R2 setup.
# OFFSITE_REMOTE=r2:followers-backups
