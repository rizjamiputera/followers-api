# syntax=docker/dockerfile:1.6

# ─── Builder ───────────────────────────────────────────────
FROM node:23.11.1-alpine3.22 AS builder
RUN apk add --no-cache python3 make g++ openssl
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml ./
COPY prisma/ ./prisma/
RUN pnpm install --frozen-lockfile
RUN pnpm exec prisma generate

COPY . .
RUN pnpm run build

# ─── Runtime ───────────────────────────────────────────────
FROM node:23.11.1-alpine3.22 AS runtime
RUN apk add --no-cache \
    openssl tini curl \
    chromium nss freetype freetype-dev harfbuzz ca-certificates \
    ttf-freefont ttf-dejavu ttf-droid ttf-liberation \
    font-noto font-noto-cjk font-noto-emoji \
    udev xvfb xvfb-run
RUN corepack enable
WORKDIR /app

ENV NODE_ENV=production \
    PORT=5000 \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY --from=builder /app/package.json /app/pnpm-lock.yaml ./
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public
COPY --from=builder /app/verify-chromium.js ./

RUN node verify-chromium.js

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT:-5000}/health" || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/main.js"]
